# -----------------------------------------------------------------------------
# Tauheed Textile — Production Environment Configuration Template
# Copy this file to .env and fill in your confidential production secrets.
# DO NOT commit .env to version control.
# -----------------------------------------------------------------------------

# 1. Database Configuration (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Authentication & JWT Fortress Secrets
JWT_SECRET="generate-a-random-32-character-high-entropy-jwt-secret-here"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YourStrongAdminPasswordHere!"
ADMIN_MASTER_PIN="786000"
ADMIN_SESSION_SECRET="generate-another-random-32-character-secret-key-for-admin-sessions"
OWNER_MASTER_KEY="tauheed-owner-shield-key-2026"

# 3. Canonical Base Domain & URLs
NEXT_PUBLIC_BASE_URL="https://tauheedtextile.com"

# 4. Optional: Third-Party & Analytics Integrations
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
TURNSTILE_SECRET_KEY="0x4AAAAAA..."
GEMINI_API_KEY="your-gemini-api-key-here"

# 5. Production Node Environment
NODE_ENV="production"

